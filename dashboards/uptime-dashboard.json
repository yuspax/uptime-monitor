    {
      "id": 5,
      "title": "Response time by site",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "cg20yu0bk4wzka"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cg20yu0bk4wzka"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, latency_ms AS value, site AS metric FROM http_logs WHERE $__timeFilter(timestamp) AND status = 'UP' ORDER BY timestamp",
          "format": "time_series"
        }
