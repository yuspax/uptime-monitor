        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cg20yu0bk4wzka"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT EXTRACT(EPOCH FROM (NOW() - MAX(timestamp))) AS value FROM http_logs",
