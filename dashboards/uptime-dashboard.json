            "type": "postgres",
            "uid": "cg20yu0bk4wzka"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT site) AS value FROM http_logs WHERE $__timeFilter(timestamp)",
          "format": "table"
