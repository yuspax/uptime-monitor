    {
      "id": 2,
      "title": "Availability in selected period",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "cg20yu0bk4wzka"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
